set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "")
set(CMAKE_C_COMPILER /usr/bin/clang)
set(CMAKE_CXX_COMPILER /usr/bin/clang++)
set(CMAKE_CROSSCOMPILING FALSE)
set(ARK_BENCH_DEPS_PREPARED ON CACHE BOOL "Dependencies fetched by bootstrap_deps.py")
set(CMAKE_POLICY_VERSION_MINIMUM 3.5 CACHE STRING "Allow upstream dependencies")
set(PANDA_ENABLE_CCACHE OFF CACHE BOOL "")
set(PANDA_LLVM_BACKEND OFF CACHE BOOL "")
set(PANDA_CROSS_COMPILER OFF CACHE BOOL "")
set(PANDA_PRODUCT_BUILD ON CACHE BOOL "Use upstream release configuration" FORCE)
set(PANDA_WITH_ETS ON CACHE BOOL "")
set(PANDA_USE_64_BIT_POINTER ON CACHE BOOL "Darwin heap mappings are not constrained below 4 GiB" FORCE)
set(ARK_BENCH_ENABLE_MAC_CODEGEN ON CACHE BOOL "Experimental standalone Mac runtime" FORCE)
set(ARK_BENCH_CODEGEN_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/../vendor/runtime_core/static_core/compiler/optimizer/code_generator")
set(CMAKE_CXX_FLAGS "-I${ARK_BENCH_CODEGEN_INCLUDE} -D_XOPEN_SOURCE=700 -D_DARWIN_C_SOURCE -Wno-unused-command-line-argument -Wno-error=deprecated-literal-operator -Wno-error=unnecessary-virtual-specifier -Wno-error=deprecated-declarations -Wno-error=unused-parameter" CACHE STRING "" FORCE)
set(CMAKE_C_FLAGS "-Wno-unused-command-line-argument" CACHE STRING "" FORCE)
