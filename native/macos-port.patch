diff --git a/static_core/irtoc/backend/macos_assembly.h b/static_core/irtoc/backend/macos_assembly.h
new file mode 100644
index 00000000..0fabbbab
--- /dev/null
+++ b/static_core/irtoc/backend/macos_assembly.h
@@ -0,0 +1,112 @@
+/*
+ * Copyright (c) 2026.
+ * Licensed under the Apache License, Version 2.0.
+ */
+#ifndef PANDA_IRTOC_MACOS_ASSEMBLY_H
+#define PANDA_IRTOC_MACOS_ASSEMBLY_H
+
+#include <algorithm>
+#include <cstdint>
+#include <iomanip>
+#include <ostream>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ark::irtoc {
+
+// Darwin's ARM64_RELOC_BRANCH26. Keep this format-specific value separate from
+// ELF's R_AARCH64_CALL26; the instruction distinguishes B from BL in both cases.
+inline constexpr uint32_t MACHO_ARM64_BRANCH26 = 2;
+
+struct MacAssemblyRelocation {
+    uint32_t offset;
+    uint32_t type;
+    int32_t addend;
+    std::string symbol;
+};
+
+inline bool IsMacAssemblySymbol(std::string_view name)
+{
+    if (name.empty()) {
+        return false;
+    }
+    auto first = [](char value) {
+        return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z') ||
+               value == '_' || value == '.' || value == '$';
+    };
+    if (!first(name.front())) {
+        return false;
+    }
+    return std::all_of(name.begin(), name.end(), [&](char value) {
+        return first(value) || (value >= '0' && value <= '9');
+    });
+}
+
+// Build-time serialization only: no register/ABI/stack-map transformations.
+// Let Apple's assembler produce native relocations rather than constructing
+// Mach-O structures or treating ELF relocation tags as Darwin relocation tags.
+inline bool WriteMacArm64Function(std::ostream &out, std::string_view name,
+                                  const std::vector<uint8_t> &code,
+                                  const std::vector<MacAssemblyRelocation> &relocations,
+                                  uint32_t alignment, std::string *error)
+{
+    auto fail = [&](const char *message) {
+        *error = message;
+        return false;
+    };
+    if (!IsMacAssemblySymbol(name) || code.empty() || code.size() % 4 != 0 ||
+        alignment < 4 || (alignment & (alignment - 1)) != 0) {
+        return fail("invalid ARM64 function, code size, or alignment");
+    }
+    auto sorted = relocations;
+    std::sort(sorted.begin(), sorted.end(), [](const auto &left, const auto &right) {
+        return left.offset < right.offset;
+    });
+    for (size_t i = 0; i < sorted.size(); ++i) {
+        const auto &rel = sorted[i];
+        if (rel.type != MACHO_ARM64_BRANCH26 || rel.offset % 4 != 0 ||
+            static_cast<uint64_t>(rel.offset) + 4 > code.size() ||
+            rel.addend % 4 != 0 || !IsMacAssemblySymbol(rel.symbol) ||
+            (i != 0 && sorted[i - 1].offset == rel.offset)) {
+            return fail("invalid or unsupported Mach-O ARM64 relocation");
+        }
+    }
+    uint32_t power = 0;
+    for (uint32_t value = alignment; value > 1; value >>= 1U) {
+        ++power;
+    }
+    out << ".text\n.p2align " << power << "\n.globl _" << name << "\n_" << name << ":\n";
+    size_t nextRelocation = 0;
+    for (size_t offset = 0; offset < code.size(); offset += 4) {
+        uint32_t instruction = static_cast<uint32_t>(code[offset]) |
+            (static_cast<uint32_t>(code[offset + 1]) << 8U) |
+            (static_cast<uint32_t>(code[offset + 2]) << 16U) |
+            (static_cast<uint32_t>(code[offset + 3]) << 24U);
+        if (nextRelocation < sorted.size() && sorted[nextRelocation].offset == offset) {
+            const auto &rel = sorted[nextRelocation++];
+            const uint32_t opcode = instruction & 0xfc000000U;
+            if ((opcode != 0x14000000U && opcode != 0x94000000U) ||
+                (instruction & 0x03ffffffU) != 0) {
+                return fail("branch relocation does not identify an unresolved B/BL instruction");
+            }
+            out << (opcode == 0x94000000U ? "  bl _" : "  b _") << rel.symbol;
+            if (rel.addend > 0) {
+                out << '+';
+            }
+            if (rel.addend != 0) {
+                out << rel.addend;
+            }
+            out << '\n';
+        } else {
+            out << "  .long 0x" << std::hex << std::setw(8) << std::setfill('0')
+                << instruction << std::dec << '\n';
+        }
+    }
+    if (!out.good()) {
+        return fail("failed to write Mach-O assembly");
+    }
+    return true;
+}
+}  // namespace ark::irtoc
+#endif
