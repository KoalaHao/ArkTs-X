// Matched headless game CPU workloads. Dart counterpart is generated by
// generate_game_dart.py; this is deliberately a restricted shared source.
interface GameWorld { tick(): number; }

function floorInt(v: number): int { return Double.toInt(Math.floor(v)); }
function readInt(a: Int32Array, i: int): int { return Double.toInt(a[i]); }
function nowStamp(): long { return Chrono.nanoNow(); }
function stampMs(delta: long): number { return Long.toDouble(delta) * 0.000001; }

class GameActor {
  x: number = 0.0;
  y: number = 0.0;
  vx: number = 0.0;
  vy: number = 0.0;
  phase: int = 0;
  update(f: int): void {
    this.x += this.vx * 0.016666666666666666;
    this.y += this.vy * 0.016666666666666666;
  }
}
class DragActor extends GameActor {
  override update(f: int): void {
    this.vx = this.vx * 0.999 + ((f + this.phase) % 17 - 8) * 0.0001;
    this.vy = this.vy * 0.998 + 0.001;
    this.x += this.vx * 0.016666666666666666;
    this.y += this.vy * 0.016666666666666666;
  }
}
class SteeringActor extends GameActor {
  override update(f: int): void {
    this.vx += (this.x < 0.0 ? 1.0 : -1.0) * 0.002;
    this.vy += (this.y < 0.0 ? 1.0 : -1.0) * 0.002;
    this.x += this.vx * 0.016666666666666666;
    this.y += this.vy * 0.016666666666666666;
  }
}
class ActorWorld implements GameWorld {
  actors: GameActor[] = [];
  frame: int = 0;
  constructor() {
    for (let i: int = 0; i < 10000; i++) {
      const a: GameActor = i % 3 == 0 ? new GameActor() :
        (i % 3 == 1 ? new DragActor() : new SteeringActor());
      a.x = (i % 251) - 125.0 + 0.1234;
      a.y = ((i * 17) % 251) - 125.0 + 0.4321;
      a.vx = (i % 19 - 9) * 0.25;
      a.vy = (i % 13 - 6) * 0.25;
      a.phase = i % 17;
      this.actors.push(a);
    }
  }
  tick(): number {
    const f = this.frame++;
    let sum: number = 0.0;
    for (let i: int = 0; i < this.actors.length; i++) {
      const a = this.actors[i];
      a.update(f);
      if (a.x >= 128.0) a.x -= 256.0;
      if (a.x < -128.0) a.x += 256.0;
      if (a.y >= 128.0) a.y -= 256.0;
      if (a.y < -128.0) a.y += 256.0;
      sum += a.x * 0.125 + a.y * 0.0625 + a.vx * 0.5 + a.vy;
    }
    return sum;
  }
}

class ParticleWorld implements GameWorld {
  data: Float64Array = new Float64Array(50000 * 7);
  frame: int = 0;
  constructor() {
    for (let i: int = 0; i < 50000; i++) this.spawn(i, 0);
  }
  spawn(i: int, f: int): void {
    const d = this.data;
    d[i] = ((i * 17) % 1024) * 0.0625 - 32.0;
    d[50000 + i] = ((i * 31) % 512) * 0.0625;
    d[100000 + i] = ((i * 13) % 1024) * 0.0625 - 32.0;
    d[150000 + i] = (i % 17 - 8) * 0.125;
    d[200000 + i] = 1.0 + (i % 11) * 0.25;
    d[250000 + i] = (i % 13 - 6) * 0.125;
    d[300000 + i] = 0.05371234567 + ((i + f) % 120) * 0.0101;
  }
  tick(): number {
    const f = this.frame++;
    const d = this.data;
    let sum: number = 0.0;
    for (let i: int = 0; i < 50000; i++) {
      d[300000 + i] -= 0.016666666666666666;
      if (d[300000 + i] <= 0.0) {
        this.spawn(i, f);
      } else {
        d[150000 + i] += 0.0001;
        d[200000 + i] -= 0.16333333333333333;
        d[i] += d[150000 + i] * 0.016666666666666666;
        d[50000 + i] += d[200000 + i] * 0.016666666666666666;
        d[100000 + i] += d[250000 + i] * 0.016666666666666666;
      }
      sum += d[i] * 0.125 + d[50000 + i] * 0.0625 +
        d[100000 + i] * 0.03125 + d[300000 + i];
    }
    return sum;
  }
}

class SceneWorld implements GameWorld {
  local: Float64Array = new Float64Array(8191 * 12);
  world: Float64Array = new Float64Array(8191 * 12);
  dirty: Int32Array = new Int32Array(8191);
  frame: int = 0;
  constructor() {
    const l = this.local;
    for (let i: int = 0; i < 8191; i++) {
      const b = i * 12;
      const r = (i % 7 - 3) * 0.001;
      l[b] = 1.0 + (i % 3) * 0.0001;
      l[b + 1] = -r; l[b + 2] = 0.001;
      l[b + 3] = (i % 17 - 8) * 0.25;
      l[b + 4] = r; l[b + 5] = 0.99995; l[b + 6] = -0.002;
      l[b + 7] = (i % 13 - 6) * 0.25;
      l[b + 8] = -0.001; l[b + 9] = 0.002; l[b + 10] = 1.0;
      l[b + 11] = (i % 11 - 5) * 0.25;
    }
  }
  tick(): number {
    const f = this.frame++;
    const l = this.local;
    const w = this.world;
    const dirty = this.dirty;
    let sum: number = 0.0;
    for (let i: int = 0; i < 8191; i++) {
      const b = i * 12;
      const parent: int = i == 0 ? -1 : floorInt((i - 1) * 0.5);
      const changed = (i + f) % 16 == 0;
      if (changed) {
        l[b + 3] += 0.001;
        if (l[b + 3] > 8.0) l[b + 3] -= 16.0;
      }
      const update = changed || (parent >= 0 && dirty[parent] != 0);
      dirty[i] = update ? 1 : 0;
      if (update) {
        if (parent < 0) {
          for (let c: int = 0; c < 12; c++) w[b + c] = l[b + c];
        } else {
          const p = parent * 12;
          for (let row: int = 0; row < 3; row++) {
            const q = row * 4;
            for (let c: int = 0; c < 4; c++) {
              w[b + q + c] = w[p + q] * l[b + c] + w[p + q + 1] * l[b + 4 + c] +
                w[p + q + 2] * l[b + 8 + c] + (c == 3 ? w[p + q + 3] : 0.0);
            }
          }
        }
      }
      const x = w[b + 3]; const y = w[b + 7]; const z = w[b + 11];
      if (x >= -21.0 && x <= 21.0 && y >= -21.0 && y <= 21.0 && z >= -11.0 && z <= 41.0) {
        sum += 1.0 + i * 0.0001 + x * 0.01 + y * 0.02 + z * 0.03;
      }
    }
    return sum;
  }
}

class CollisionWorld implements GameWorld {
  x: Float64Array = new Float64Array(2048);
  y: Float64Array = new Float64Array(2048);
  heads: Int32Array = new Int32Array(1024);
  next: Int32Array = new Int32Array(2048);
  frame: int = 0;
  constructor() {
    for (let i: int = 0; i < 2048; i++) {
      this.x[i] = ((i * 37) % 4096) * 0.03125 - 64.0;
      this.y[i] = ((i * 101) % 4096) * 0.03125 - 64.0;
    }
  }
  tick(): number {
    this.frame++;
    const x = this.x; const y = this.y; const heads = this.heads; const next = this.next;
    for (let c: int = 0; c < 1024; c++) heads[c] = -1;
    for (let i: int = 0; i < 2048; i++) {
      x[i] += (i % 7 - 3) * 0.002;
      y[i] += (i % 11 - 5) * 0.002;
      if (x[i] >= 64.0) x[i] -= 128.0;
      if (x[i] < -64.0) x[i] += 128.0;
      if (y[i] >= 64.0) y[i] -= 128.0;
      if (y[i] < -64.0) y[i] += 128.0;
      const c = floorInt((y[i] + 64.0) * 0.25) * 32 + floorInt((x[i] + 64.0) * 0.25);
      next[i] = heads[c]; heads[c] = i;
    }
    let sum: number = 0.0;
    for (let i: int = 0; i < 2048; i++) {
      const cx = floorInt((x[i] + 64.0) * 0.25);
      const cy = floorInt((y[i] + 64.0) * 0.25);
      for (let dy: int = -1; dy <= 1; dy++) {
        const yy = cy + dy;
        if (yy < 0 || yy >= 32) continue;
        for (let dx: int = -1; dx <= 1; dx++) {
          const xx = cx + dx;
          if (xx < 0 || xx >= 32) continue;
          let j: int = readInt(heads, yy * 32 + xx);
          while (j >= 0) {
            if (j > i) {
              const ax = x[i] - x[j]; const ay = y[i] - y[j];
              if (ax * ax + ay * ay < 2.25) sum += (i + 1) * 3 + (j + 1) * 5;
            }
            j = readInt(next, j);
          }
        }
      }
    }
    return sum;
  }
}

class GameEvent {
  entity: int = 0;
  kind: int = 0;
  amount: number = 0.0;
}
class EventWorld implements GameWorld {
  ring: GameEvent[][] = [];
  health: Float64Array = new Float64Array(4096);
  pooled: boolean = false;
  frame: int = 0;
  constructor(pooled: boolean) {
    this.pooled = pooled;
    for (let i: int = 0; i < 4096; i++) this.health[i] = 50.0;
    for (let slot: int = 0; slot < 8; slot++) {
      const events: GameEvent[] = [];
      if (pooled) for (let j: int = 0; j < 2000; j++) events.push(new GameEvent());
      this.ring.push(events);
    }
  }
  tick(): number {
    const f = this.frame++;
    const slot = f % 8;
    const events: GameEvent[] = this.pooled ? this.ring[slot] : [];
    for (let j: int = 0; j < 2000; j++) {
      const e = this.pooled ? events[j] : new GameEvent();
      e.entity = (j * 17 + f % 1024) % 4096;
      e.kind = j % 3;
      e.amount = (j % 13 + f % 7) * 0.125;
      if (!this.pooled) events.push(e);
    }
    this.ring[slot] = events;
    for (let j: int = 0; j < events.length; j++) {
      const e = events[j];
      let h = this.health[e.entity];
      if (e.kind == 0) h -= e.amount;
      else if (e.kind == 1) h += e.amount * 0.5;
      else h += e.amount * 0.125;
      if (h < 0.0) h = 100.0;
      if (h > 100.0) h = 0.0;
      this.health[e.entity] = h;
    }
    let sum: number = 0.0;
    for (let i: int = 0; i < 4096; i++) sum += this.health[i];
    if (f >= 7) {
      const older = this.ring[(slot + 1) % 8];
      for (let j: int = 0; j < 64; j++) sum += older[j].amount * (older[j].entity + 1);
    }
    return sum;
  }
}

function createWorld(kind: int): GameWorld {
  if (kind == 0) return new ActorWorld();
  if (kind == 1) return new ParticleWorld();
  if (kind == 2) return new SceneWorld();
  if (kind == 3) return new CollisionWorld();
  return new EventWorld(kind == 5);
}

function checkWorld(kind: int): Float64Array {
  const world = createWorld(kind);
  const checks = new Float64Array(2);
  for (let i: int = 0; i < 128; i++) {
    const value = world.tick();
    if (i == 7) checks[0] = value;
    if (i == 127) checks[1] = value;
  }
  return checks;
}

let warmSink: number = 0.0;
function warmWorld(kind: int): void {
  const world = createWorld(kind);
  const start = nowStamp();
  while (stampMs(nowStamp() - start) < 1000.0) warmSink += world.tick();
}

function measureGame(kind: int, name: string): void {
  console.log('GAME_STAGE ' + name + ' checks');
  const before = checkWorld(kind);
  console.log('GAME_STAGE ' + name + ' warmup');
  warmWorld(kind);
  const world = createWorld(kind);
  const samples = new Float64Array(3000);
  let sink: number = 0.0;
  console.log('GAME_STAGE ' + name + ' measured');
  for (let frame: int = 0; frame < 3000; frame++) {
    const start = nowStamp();
    sink += world.tick();
    const end = nowStamp();
    samples[frame] = stampMs(end - start);
  }
  const after = checkWorld(kind);
  console.log('GAME {"name":"' + name + '","check_before":[' + before.join(',') +
    '],"check_after":[' + after.join(',') + '],"sink":' + sink.toString() +
    ',"warm_sink":' + warmSink.toString() + ',"frames_ms":[' + samples.join(',') + ']}');
}

function main(args: FixedArray<string>): void {
  const names: string[] = ['behaviours_10k', 'particles_50k', 'scene_8191',
    'collisions_2048', 'events_alloc_2k', 'events_pool_2k'];
  for (let kind: int = 0; kind < names.length; kind++) {
    if (args.length == 0 || args[0] == names[kind]) measureGame(kind, names[kind]);
  }
}
