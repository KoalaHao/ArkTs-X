@@ -406,4 +413,38 @@ Compilation::Result Compilation::MakeElf(std::string_view output)
 
     return 0;
 }
+#else
+Compilation::Result Compilation::MakeElf(std::string_view output)
+{
+    if (arch_ != Arch::AARCH64) {
+        return Unexpected("Mach-O assembly output supports ARM64 only");
+    }
+    std::ofstream stream {std::string(output)};
+    if (!stream) {
+        return Unexpected("Cannot open Mach-O assembly output");
+    }
+    for (auto unit : units_) {
+        if (unit->IsCompiledByLlvm()) {
+            continue;
+        }
+        const auto code = unit->GetCode();
+        std::vector<uint8_t> bytes(code.begin(), code.end());
+        std::vector<MacAssemblyRelocation> relocations;
+        for (const auto &rel : unit->GetRelocations()) {
+            relocations.push_back({rel.offset, rel.type, rel.addend, unit->GetExternalFunction(rel.data)});
+        }
+        std::string error;
+        if (!WriteMacArm64Function(stream, unit->GetName(), bytes, relocations,
+                                  GetCodeAlignment(arch_), &error)) {
+            LOG(ERROR, COMPILER) << unit->GetName() << ": " << error;
+            return Unexpected("Failed to serialize Mach-O assembly");
+        }
+    }
+    stream.close();
+    if (!stream) {
+        return Unexpected("Failed to flush Mach-O assembly output");
+    }
+    return 0;
+}
+#endif
 }  // namespace ark::irtoc
